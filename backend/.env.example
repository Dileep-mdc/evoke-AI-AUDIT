# Copy to backend/.env and fill in. Every setting is optional; the commented value is the default.
# What each one does is documented beside it in app/config.py.

# --- Keys and contact -------------------------------------------------------------------------
ENABLE_LLM_SCORING=false
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# CRUX_API_KEY=                       (falls back to GOOGLE_API_KEY)
# Your organisation's website or mailto:, sent to Wikimedia as their API policy asks.
AUDIT_CONTACT_URL=

# --- Models, search and cost ------------------------------------------------------------------
# LLM_MODEL=gpt-4o-mini
# OPENAI_SEARCH_MODEL=                (falls back to LLM_MODEL)
# SEARCH_PROVIDER=auto                (google | openai | auto)
# LLM_PRICE_INPUT_PER_M=0.15
# LLM_PRICE_OUTPUT_PER_M=0.60
# OPENAI_SEARCH_PRICE_PER_CALL=0
# LLM_SCAN_BUDGET_USD=0               (0 = no cap)

# --- Third-party endpoints --------------------------------------------------------------------
# GOOGLE_SEARCH_ENDPOINT=https://www.googleapis.com/customsearch/v1
# SEARCH_DISPLAY_URL=https://www.google.com/search?q=
# WIKIDATA_API=https://www.wikidata.org/w/api.php
# WIKIPEDIA_API=https://en.wikipedia.org/w/api.php
# CRUX_ENDPOINT=https://chromeuxreport.googleapis.com/v1/records:queryRecord
# REFERENCE_LANGUAGE=en

# --- Crawler ----------------------------------------------------------------------------------
# CRAWLER_UA=AIVisibilityAuditBot/1.0 (compatible; automated site audit tool)
# BROWSER_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
# AI_BOTS=GPTBot,ChatGPT-User,ClaudeBot,Google-Extended,Googlebot
# MAX_PAGES=2500
# MAX_SITEMAP_URLS=5000
# CONCURRENCY=24
# REQUEST_TIMEOUT=20
# CONNECT_TIMEOUT=8
# RETRIES=2
# RETRY_BACKOFF_SECONDS=0.4
# MAX_REDIRECTS=8
# MAX_BODY_BYTES=2000000
# MAX_DISCOVERY_ROUNDS=3
# CRAWL_TIME_BUDGET=900
# ENABLE_RENDER=true
# RENDER_BUDGET=40
# RENDER_TIMEOUT=20
# RENDER_NETWORK_IDLE_MS=2500

# --- Scoring and model calls ------------------------------------------------------------------
# SCORING_RULES_PATH=                 (replacement for app/parameters/scoring_rules.json)
# PARAMETER_CONCURRENCY=6
# PARAMETER_TIMEOUT=90
# JUDGEMENT_TIMEOUT=240
# LLM_TIMEOUT=20
# LLM_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=0.6
# LLM_RATE_LIMIT_RETRIES=5
# LLM_RATE_LIMIT_BASE_SECONDS=2
# LLM_RATE_LIMIT_MAX_SLEEP=30
# LLM_CONCURRENCY=12
# OPENAI_SEARCH_RATE_LIMIT_WAITS=10,20,40
# OPENAI_SEARCH_MAX_WAIT=60
# OFFPAGE_SOURCE_TEXT_CHARS=20000

# --- Storage ----------------------------------------------------------------------------------
# AUDIT_DATA_DIR=
# OUTPUT_GZIP_LEVEL=6
# OUTPUT_WRITE_WORKERS=8
