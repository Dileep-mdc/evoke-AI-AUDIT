# Copy this file to .env and fill in real values. Never commit .env itself.

# Set to true to let parameter checks call OpenAI for LLM-assisted judgment.
# Defaults to false -- scans run exactly as before (deterministic heuristics only)
# until this is explicitly enabled and a real API key is set below.
ENABLE_LLM_SCORING=false

# Required if ENABLE_LLM_SCORING=true.
OPENAI_API_KEY=

# Optional: override the default model.
LLM_MODEL=gpt-4o-mini
